flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        CLI["CLI<br/>build, verify, recover"]:::edge
        Client(["HTTP client"]):::edge
        Router["HTTP router<br/>/report /verify /lineage"]:::core
        Validate["Validation<br/>known artifact id"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph Exec["Tracked execution"]
        direction TB
        Dataset[("Dataset + config<br/>root artifacts")]:::data
        Transforms["Transform registry<br/>standardize, ridge, eval"]:::core
        CodeHash["Code fingerprint<br/>hash of source"]:::core
        Plan["Journaled runner<br/>resume after crash"]:::control
        Execute["Execute run<br/>content-addressed id"]:::core
        Dataset ~~~ Transforms --> CodeHash --> Execute
        Plan --> Execute
    end

    subgraph State["Provenance state"]
        direction TB
        Store[("Content store<br/>dedup by hash")]:::data
        Ledger[("Ledger<br/>lineage DAG of runs")]:::data
        Journal[("Journal<br/>per-step snapshots")]:::data
        Store ~~~ Ledger ~~~ Journal
    end

    subgraph Obs["Verification and reports"]
        direction TB
        Lineage["Artifact lineage<br/>ancestor runs"]:::obs
        Verify["Lineage verification<br/>re-execute, integrity"]:::obs
        Reproduce["Rebuild + compare<br/>every content hash"]:::obs
        Report["Provenance report<br/>artifacts, metrics"]:::obs
        Metrics["Route metrics<br/>Prometheus text"]:::obs
        Lineage ~~~ Verify ~~~ Reproduce ~~~ Report ~~~ Metrics
    end

    Interfaces -->|build, recover| Exec
    Exec -->|artifacts, runs| State
    Exec -->|re-execute, rebuild| Obs
