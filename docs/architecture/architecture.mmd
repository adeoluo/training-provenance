flowchart LR
    Source[Transform source] --> Code[Code fingerprint]
    Data[(Dataset and config)] --> Store[(Content store)]
    Code --> Exec[Execute run]
    Store --> Exec
    Exec --> Store
    Exec --> Ledger[(Lineage DAG)]
    Exec --> Journal[(Recovery journal)]
    Ledger --> Verify[Re-execute and verify]
    Store --> Verify
    Client([Client]) --> Router[HTTP router]
    Router --> Verify
